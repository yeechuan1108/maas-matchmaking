@base <http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE#> .

<http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-OBMMDemo> rdf:type owl:Ontology ;
                                                                     owl:imports <http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-Universal> ;
                                                                     :Comment "First try to develop Ontology-Based Matchmaking OBMM for ACCURATE" .

#################################################################
#    Data properties
#################################################################

###  http://qudt.org/schema/qudt/conversionMultiplierSN
qudt:conversionMultiplierSN rdfs:range xsd:double .


#################################################################
#    Classes
#################################################################

###  http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE#GHGEmission
:GHGEmission rdf:type owl:Class ;
             rdfs:subClassOf :SustainabilityIndicator .


###  http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-OBMMDemo#Certificate
:Certificate rdf:type owl:Class ;
             rdfs:subClassOf :ACCURATE_BaseClass .


###  http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-OBMMDemo#QualityCertificate
:QualityCertificate rdf:type owl:Class ;
                    rdfs:subClassOf :Certificate .


###  http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-OBMMDemo#SustainabilityCertificate
:SustainabilityCertificate rdf:type owl:Class ;
                           rdfs:subClassOf :Certificate .


#################################################################
#    Individuals
#################################################################

###  http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE#AL6061
:AL6061 rdf:type owl:NamedIndividual ,
                 :AluminiumAlloy .


###  http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE#MS01
:MS01 rdf:type owl:NamedIndividual ,
               :ManufacturingService ;
      :hasCharacteristic :MS01_DT_Characteristic ,
                         :MS01_GHGE_Characteristic ,
                         :MS01_EnergyCertificate_Characteristic ,
                         :MS01_Material_Characteristic ,
                         :MS01_Precision_Characteristic ,
                         :MS01_QualityCertificate_Characteristic ,
